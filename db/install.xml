<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="blocks/pulso/db" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    VERSION="20260924"
    COMMENT="XMLDB file for Moodle block Pulso"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <!-- block_pulso_history se retiró en 2026080417: estaba definida desde el
         principio pero NINGÚN código la escribía ni la leía. El historial de
         conversación vive en $SESSION y en sessionStorage del cliente. -->
    <TABLE NAME="block_pulso_content_chunks" COMMENT="RAG content chunks with embeddings">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="course_modules.id"/>
        <FIELD NAME="module_type" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="module_name" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="chunk_index" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="chunk_text" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="content_hash" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="SHA256 of chunk_text to detect changes"/>
        <FIELD NAME="embedding_json" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON array of floats (1536 dims)"/>
        <FIELD NAME="token_count" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_courseid" UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="idx_cmid" UNIQUE="false" FIELDS="cmid"/>
        <INDEX NAME="idx_hash" UNIQUE="false" FIELDS="content_hash"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="block_pulso_full_text" COMMENT="Texto completo (sin trocear) por modulo, para Epica (material.texto)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="course_modules.id; negativo = chunk sintetico (course_meta/course_section)"/>
        <FIELD NAME="module_type" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="module_name" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="texto" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Texto completo, literal, sin trocear"/>
        <FIELD NAME="caracteres" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="mb_strlen(texto), caracteres Unicode no bytes"/>
        <FIELD NAME="extraido_por" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="Herramienta/version real que extrajo el texto"/>
        <FIELD NAME="usable" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1 si is_extracted_text_useful() acepto el texto REAL extraido (no el aviso de fallo)"/>
        <FIELD NAME="content_hash" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="SHA256 de texto, para no reescribir si no ha cambiado"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_courseid" UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="idx_cmid" UNIQUE="false" FIELDS="cmid"/>
        <INDEX NAME="idx_courseid_cmid" UNIQUE="false" FIELDS="courseid, cmid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="block_pulso_encargos" COMMENT="Encargos de creacion para Epica (infografias; retos en v2). Cuenta contra los cupos anti-abuso y guarda el job id real del paso 4.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="course_modules.id del recurso origen"/>
        <FIELD NAME="sectionnum" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Seccion del recurso, para el cupo por usuario+seccion+dia"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="tool" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="infografia" SEQUENCE="false" COMMENT="infografia hoy; reto/presentacion en versiones futuras"/>
        <FIELD NAME="format" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="poster_2_3 / square / landscape_3_2"/>
        <FIELD NAME="prompt" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Que quiere el usuario, tal cual lo escribio (maximo 4000 caracteres)"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pendiente" SEQUENCE="false"/>
        <FIELD NAME="epica_job_id" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Identificador de trabajo devuelto por Epica; lo rellena el paso 4"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_courseid" UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="idx_userid" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="idx_timecreated" UNIQUE="false" FIELDS="timecreated"/>
        <INDEX NAME="idx_courseid_timecreated" UNIQUE="false" FIELDS="courseid, timecreated"/>
        <INDEX NAME="idx_userid_timecreated" UNIQUE="false" FIELDS="userid, timecreated"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>