{{!
    @template block_pulso/chat

    Shell estatico de Pulse AI (burbuja, cabecera con pestanas «Preguntar» y «Crear», home y paneles).

    Lo que no le toca a un usuario NO se renderiza (no se oculta con CSS): la UI no es control de
    acceso, pero el HTML de analitica no tiene por que llegar al navegador de un alumno.

    Context variables required for this template:
    * isotipo - URL del isotipo (pix/isotipo-oscuro; isotipo-claro si el color de centro es claro)
    * logourl - URL de pluginfile del logo del centro (carta 11 ampliada); vacío = se usa el isotipo
    * logoalt - texto alternativo del logo (nombre del sitio o «Logotipo»)
    * ilustracionurl - URL de pluginfile de la ilustración decorativa de «Crear» (v2.15.0); vacío = sin ilustración
    * hastema - true solo si Épica manda un tema válido (colores del centro, carta 11)
    * temastyle - variables por papel (--pulso-header-*, --pulso-action-*, --pulso-own-*, --pulso-accent) ya resueltas y validadas (solo con hastema)
    * temaflags - tokens de las claves EFECTIVAS: principal, cabecera, boton, burbuja, acento o acento-base, fondo, oscuro, creaciones, tarjeta, pestana (solo con hastema)
    * isteacher - true con block/pulso:viewanalytics (profesorado); false = version de alumno
    * cancreate - true con block/pulso:createactivity: hay pestana «Crear»
    * epica - true si local_awkepica esta disponible: infografia, juego, retos e historial
    * showversion - true solo con viewanalytics: insignia de version
    * release - texto de la insignia (p. ej. v1.36.0)
    * greeting - saludo de la home
    * coursename - nombre del curso (chip de contexto)

    Example context (json):
    {
        "isotipo": "https://example.com/blocks/pulso/pix/isotipo-oscuro.png",
        "hastema": true,
        "temastyle": "--pulso-header-bg:#003670;--pulso-header-text:#ffffff;",
        "temaflags": "principal cabecera",
        "isteacher": true,
        "cancreate": true,
        "epica": true,
        "showversion": true,
        "release": "v1.36.0",
        "greeting": "¡Hola, Ana! ¿Qué quieres saber de tu curso?",
        "coursename": "Estadística aplicada"
    }
}}

<!-- Botón circular flotante -->
<button class="pulso-chat-bubble" id="pulso-chat-bubble"{{#hastema}} style="{{temastyle}}" data-pulso-tema="{{temaflags}}"{{/hastema}} data-pulso-action="toggleChat" title="Pulse AI — Asistente del curso" aria-label="Abrir el asistente Pulse AI" aria-expanded="false" aria-controls="pulso-chat-container">
    {{#logourl}}<img class="pulso-logo-centro" src="{{logourl}}" alt="{{logoalt}}">{{/logourl}}{{^logourl}}<img src="{{isotipo}}" alt="" aria-hidden="true">{{/logourl}}
</button>

<div class="pulso-chat-container" id="pulso-chat-container"{{#hastema}} style="{{temastyle}}" data-pulso-tema="{{temaflags}}"{{/hastema}} role="region" aria-label="Pulse AI">
    <div class="pulso-chat-header" id="pulso-chat-header">
        <div class="pulso-header-top">
            <div class="pulso-header-brand">
                {{#logourl}}<img class="pulso-header-logo pulso-logo-centro" src="{{logourl}}" alt="{{logoalt}}">{{/logourl}}{{^logourl}}<img class="pulso-header-logo" src="{{isotipo}}" alt="" aria-hidden="true">{{/logourl}}
                <div>
                    <h2>Pulse AI{{#showversion}} <span class="pulso-version-badge">{{release}}</span>{{/showversion}}</h2>
                    <span class="pulso-header-sub"><span class="pulso-status-dot" aria-hidden="true"></span>Asistente del curso</span>
                </div>
            </div>
            <div class="header-controls">
                <button class="header-btn" id="pulso-clear-btn" title="Nueva conversación" aria-label="Empezar una conversación nueva" aria-expanded="false" aria-controls="pulso-clear-confirm" data-pulso-action="clearConversation">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><polyline points="3 4 3 9 8 9"/></svg>
                </button>
                <button type="button" class="header-btn" id="pulso-expand-btn" title="Ampliar" aria-label="Ampliar el chat" aria-pressed="false" data-pulso-action="toggleChatSize">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
                </button>
                <button class="header-btn" id="pulso-minimize-btn" title="Minimizar" aria-label="Minimizar el chat" data-pulso-action="toggleChat">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
            </div>
        </div>
        {{#cancreate}}
        <div class="pulso-tabs" id="pulso-tablist" role="tablist" aria-label="Secciones de Pulse AI">
            <button type="button" class="pulso-tab" role="tab" id="pulso-tab-ask" aria-controls="pulso-panel-ask" aria-selected="true" tabindex="0" data-pulso-tab="ask" data-pulso-action="selectTab" data-pulso-arg="ask">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                <span>Preguntar</span>
            </button>
            <button type="button" class="pulso-tab" role="tab" id="pulso-tab-crear" aria-controls="pulso-panel-crear" aria-selected="false" tabindex="-1" data-pulso-tab="crear" data-pulso-action="selectTab" data-pulso-arg="crear">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8z"/></svg>
                <span>Crear</span>
            </button>
        </div>
        {{/cancreate}}
    </div>

    <div class="pulso-tabpanel" id="pulso-panel-ask" {{#cancreate}}role="tabpanel" aria-labelledby="pulso-tab-ask"{{/cancreate}}>
        <div class="pulso-chat-messages" id="pulso-scroll">
            <div class="pulso-home" id="pulso-home">
                <div class="pulso-home-hello">
                    <div class="pulso-home-avatar" aria-hidden="true"></div>
                    <h3>{{greeting}}</h3>
                </div>

                <button type="button" class="pulso-home-help-btn" data-pulso-action="showCapabilities" aria-label="Descubre qué puede hacer Pulse">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    <span>¿Qué puede hacer Pulse?<span class="pulso-home-help-sub">Descúbrelo en 10 segundos</span></span>
                </button>

                {{! Catálogo de prompts preestablecidos (v2.14.0): lo arma chat_presets::home_groups() para el rol de quien mira. }}
                <div class="pulso-home-section">
                    <div class="pulso-home-section-head">
                        <h3 class="pulso-home-section-title">Elige qué quieres pedir</h3>
                        <span class="pulso-home-context-chip">{{coursename}}</span>
                    </div>
                    <p class="pulso-preset-home-hint">Toca un prompt para ver sus opciones, o empieza a escribir y te los iré sugiriendo.</p>
                    {{#presetgroups}}
                    <h4 class="pulso-home-ideas-title">{{title}}</h4>
                    <ul class="pulso-home-ideas-list">
                        {{#items}}
                        <li><button type="button" class="pulso-idea pulso-preset-idea" data-pulso-action="pulsoPresetPick" data-pulso-arg="{{id}}"><span>{{label}}</span>{{#hasparams}}<span class="pulso-preset-idea-more" aria-hidden="true">Opciones</span>{{/hasparams}}</button></li>
                        {{/items}}
                    </ul>
                    {{/presetgroups}}
                </div>
            </div>

            <!-- Región en vivo SOLO para mensajes: la home y los paneles de pestaña quedan fuera. -->
            <div class="pulso-log" id="pulso-messages" role="log" aria-live="polite" aria-relevant="additions" aria-label="Conversación con Pulse AI"></div>
        </div>

        <div class="pulso-offline" id="pulso-offline" hidden>Sin conexión. Tus preguntas se enviarán cuando vuelva internet.</div>

        <div class="pulso-clear-confirm" id="pulso-clear-confirm" role="group" aria-labelledby="pulso-clear-confirm-text" hidden>
            <p class="pulso-clear-confirm-text" id="pulso-clear-confirm-text">¿Empezar una conversación nueva? Se borrará esta conversación.</p>
            <div class="pulso-clear-confirm-actions">
                <button type="button" class="pulso-clear-confirm-yes" data-pulso-action="pulsoClearConfirm">Empezar de nuevo</button>
                <button type="button" class="pulso-clear-confirm-no" data-pulso-action="pulsoClearCancel">Cancelar</button>
            </div>
        </div>

        <div class="pulso-chat-input-area">
            {{! Prompts preestablecidos (v2.14.0, amd/src/presets.js): panel de opciones del prompt elegido y lista de sugerencias mientras se escribe. Fuera del <form>: Enter en un campo del panel no envía el cuadro de texto. }}
            <div class="pulso-preset-panel" id="pulso-preset-panel" role="group" aria-labelledby="pulso-preset-title" hidden></div>
            <ul class="pulso-preset-suggest" id="pulso-preset-suggest" role="listbox" aria-label="Prompts sugeridos" hidden></ul>
            <form id="pulso-chat-form">
                <div class="pulso-input-group">
                    <input
                        type="text"
                        id="pulso-input"
                        placeholder="Escribe y te sugiero un prompt..."
                        maxlength="500"
                        autocomplete="off"
                        aria-label="Escribe tu pregunta sobre el curso. Mientras escribes se sugieren prompts."
                        role="combobox"
                        aria-autocomplete="list"
                        aria-controls="pulso-preset-suggest"
                        aria-expanded="false"
                    />
                    <button type="button" id="pulso-mic-btn" class="pulso-mic-btn" style="display:none;" aria-label="Dictar pregunta por voz" aria-pressed="false" title="Dictar por voz" data-pulso-action="toggleMic">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 15a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-2.08A7 7 0 0 0 19 12h-2Z"/></svg>
                    </button>
                    <button type="submit" class="pulso-send-btn" id="pulso-send-btn" aria-label="Enviar pregunta" aria-disabled="true">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.4 20.4 21.85 12 3.4 3.6l-.01 6.53L15 12 3.39 13.87z"/></svg>
                    </button>
                </div>
            </form>
            <div class="pulso-char-count" id="pulso-char-count-box" aria-hidden="true" hidden>
                <span id="pulso-char-count">0</span>/500
            </div>
        </div>
    </div>

    {{#cancreate}}
    <div class="pulso-tabpanel" id="pulso-panel-crear" role="tabpanel" aria-labelledby="pulso-tab-crear"{{#ilustracionurl}} data-pulso-ilustracion{{/ilustracionurl}} hidden>
        <div class="pulso-chat-messages" id="pulso-crear-scroll">
            <div class="pulso-create-root" id="pulso-create-root">
                <h3 class="pulso-create-root-title" id="pulso-create-root-title" tabindex="-1">¿Qué quieres crear?</h3>
                {{> block_pulso/chat_create_tools}}
                {{! Ilustración del centro (v2.15.0): decorativa, a la derecha de la lista. Solo con sitio para ella (styles.css). }}
                {{#ilustracionurl}}
                <img class="pulso-ilustracion" src="{{ilustracionurl}}" alt="" aria-hidden="true">
                {{/ilustracionurl}}
                {{! El pie de «Mis creaciones» (historial en Épica) solo existe en el HTML del alumnado con Épica: el JS lo copia de esta plantilla inerte al pintar esa pantalla. }}
                {{^isteacher}}{{#epica}}
                <template id="pulso-mine-historial-tpl">
                    <div class="pulso-mine-historial">
                        <button type="button" class="pulso-historial-link" data-pulso-action="pulsoAbrirHistorial">Mi historial en Épica<span aria-hidden="true"> ↗</span><span class="pulso-sr-only"> (se abre en una pestaña nueva)</span></button>
                        <p class="pulso-create-hint">Se abre en una pestaña nueva. En el historial de Épica solo aparece lo creado desde el 5 de octubre de 2026.</p>
                    </div>
                </template>
                {{/epica}}{{/isteacher}}
                {{! Lo mismo para el profesorado con Épica: «Mis proyectos» (carta 19). }}
                {{#isteacher}}{{#epica}}
                <template id="pulso-mine-proyectos-tpl">
                    <div class="pulso-mine-historial">
                        <button type="button" class="pulso-historial-link" data-pulso-action="pulsoAbrirProyectos">Mis proyectos en Épica<span aria-hidden="true"> ↗</span><span class="pulso-sr-only"> (se abre en una pestaña nueva)</span></button>
                        <p class="pulso-create-hint">Ahí está lo que has creado o publicado en Épica. Lo que creas desde el chat de Pulse está en esta lista.</p>
                    </div>
                </template>
                {{/epica}}{{/isteacher}}
            </div>

            <div class="pulso-create-panel" id="pulso-create-panel" hidden>
                <div class="pulso-create-head">
                    <button type="button" class="pulso-create-back" id="pulso-create-back" data-pulso-action="pulsoCreateBack" aria-label="Volver a la lista de herramientas de creación">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                        <span>Volver</span>
                    </button>
                    <h3 id="pulso-create-title" tabindex="-1">Crear</h3>
                </div>
                <div class="pulso-create-body" id="pulso-create-body">
                    <p class="pulso-create-hint">Cargando…</p>
                </div>
            </div>
        </div>
    </div>
    {{/cancreate}}

    <!-- Avisos breves para lector de pantalla (estado de una creación, conexión, límite de caracteres). Fuera de los paneles. -->
    <div class="pulso-sr-only" id="pulso-live-status" role="status" aria-live="polite" aria-atomic="true"></div>
</div>
